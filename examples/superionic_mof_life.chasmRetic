; ==========================================
; PROGRAM: SUPERIONIC_MOF_LIFE.chasmRetic
; ==========================================
ORG 0x1E00

START:
    LOAD_MOL R1, H2O_LIQUID
    COMPRESS_TPA R1, 2.0_TPa
    HEAT 2000K
    PHASE_SUPERIONIC R1
    EXTRACT R2, ICE_XVIII_METALLIC

    LOAD_MOL R3, ZR6_O4_OH4_CLUSTER
    DESIGN_SBU R3, OCTAHEDRAL
    LOAD_MOL R4, BDC_LINKER
    RETICULAR_CLICK R3, R4, FCU_TOPOLOGY
    ACTIVATE_VOID R3_R4_FRAMEWORK

    LOAD_MOL R5, HCN_EUTECTIC
    ENCAPSULATE_GUEST R3_R4_FRAMEWORK, R5
    WET_DRY_CYCLE R3_R4_FRAMEWORK, 100_CYCLES
    EUTECTIC_FREEZE R5, 255K

    AUTOCATALYZE_AZX R3_R4_FRAMEWORK_PORES
    CMP_FLAG AUTOCATALYTIC_LIFE
    JZ LIFE_FAIL

    VESICULATE DECANOIC_ACID_METEORITIC
    OUT PROTOCELL, BIOSAFETY_LAB
    HALT

LIFE_FAIL:
    LOG "Prebiotic soup did not achieve autocatalytic replication."
    HALT
