; ==========================================
; PROGRAM: QUANTUM_P450_LSF.chasmFrt
; ==========================================
ORG 0x0E00

START:
    LOAD_MOL R1, P450_COMPOUND_I
    RUN_VQE R1, UCCSD_ANSATZ
    METADYNAMICS R1, FE_O_DIST, H_ABST_DIST
    
    LOAD_MOL R2, STRYCHNINE_CORE
    LATE_STAGE_FUNCTIONALIZE R2, C15_H
    IMPRINT_PALLADACYCLE R2, AMIDE_DG
    
    LOAD_MOL R3, WILDTYPE_P450_BM3
    SATURATION_MUTAGENESIS R3, ACTIVE_SITE_RESIDUES
    PAN_HIGH_THROUGHPUT R3_LIBRARY, HPLC_ASSAY
    RECOMBINE_BEST_VARIANTS VARIANT_4B, VARIANT_9C
    
    COOL 4K
    DEPOSIT R2, CU_111_SURFACE
    STM_ATOM_MANIPULATE CO_TIP, R2
    OUT R2, NATURE_PAPER_FORMAT
    HALT
