; ==========================================
; PROGRAM: PLASMON_PARALLEL_SCREEN.chasmPlasm
; ==========================================
ORG 0x2200

START:
    LOAD_MOL R1, ARYL_BROMIDE_SUBSTRATE
    LOAD_MOL R2, AMINE_NUCLEOPHILE
    BRANCH_PARALLEL 96
    ASSIGN_ARRAY NANOROD_LIBRARY, REACTOR_ARRAY

    PARALLEL_FOREACH REACTOR in REACTOR_ARRAY:
        TRY:
            EXCITE_PLASMON REACTOR.NANOROD, REACTOR.RESONANCE_LAMBDA
            GENERATE_HOT_CARRIERS REACTOR.PLASMON
            INJECT_CARRIER REACTOR.HOT_ELECTRON, R1
            PLASMONIC_HEATING REACTOR.NANOROD, 400K
        CATCH THERMAL_RUNAWAY:
            QUENCH_REACTOR REACTOR, LIQUID_N2
            FLAG_REACTOR_FAILED REACTOR
        ENDTRY
    END_PARALLEL

    MERGE_DROPLETS SUCCESSFUL_REACTORS -> VESSEL_MAIN
    STATE_COMMIT POST_REACTION_CLEAN
    
    EXTRACT R3, C_N_PRODUCT
    AUDIT_PMI R3
    CMP_PMI 50
    JG PMI_TOO_HIGH

    TRY:
        HPLC_SEPARATE R3
    CATCH COLUMN_FAILURE:
        STATE_REVERT POST_REACTION_CLEAN
        JMP TRY
    ENDTRY

    OUT R3
    HALT

PMI_TOO_HIGH:
    LOG "Process Mass Intensity exceeds green chemistry limits."
    HALT
